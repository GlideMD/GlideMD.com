# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Settings → Environment Variables.

# Your EHR vendor's hosted clinical intake URL (Healthie / Elation).
# Everything past this URL is PHI and lives under their BAA, not yours.
NEXT_PUBLIC_INTAKE_URL=

# Public site URL, used for canonical tags and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://glidemd.com

# --- Do NOT add here ---
# No PHI, no clinical database credentials, no e-prescribing API keys.
# Those belong to the compliant backend, not this marketing app. If you
# find yourself adding a DoseSpot or pharmacy credential to this file,
# the integration is being built in the wrong place.
